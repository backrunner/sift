# Copy this file to .env.signal-model and keep the real file out of git.
#
# The model upload script loads .env.signal-model automatically when
# present. You can also pass --env-file /path/to/file or set
# SIFT_SIGNAL_MODEL_ENV_FILE.

# Public HTTPS root used for immutable releases and the signed current-app channel.
SIFT_SIGNAL_MODEL_BASE_URL=https://sift.alkinum.com/models

# Ed25519 private key used only by the publisher. Generate it with:
#   openssl genpkey -algorithm ED25519 -out ~/.config/sift/model-release-ed25519.pem
# Put the matching raw public-key base64 in SiftApp release configuration.
SIFT_MODEL_SIGNING_KEY=/absolute/path/to/model-release-ed25519.pem
SIFT_MODEL_SIGNING_KEY_ID=release-2026
# Optional when /usr/bin/openssl is LibreSSL; the publisher auto-detects
# Homebrew OpenSSL 3, or you can set an explicit binary here.
# SIFT_OPENSSL_BIN=/opt/homebrew/bin/openssl

# Cloudflare R2 destination. Releases go under models/releases and the mutable
# channel pointers go under models/channels/v4 for the current app line.
# Uploads use Wrangler, so sign in with `pnpm -C apps/site exec wrangler login`
# or set CLOUDFLARE_API_TOKEN. No S3 access keys are needed.
SIFT_MODEL_R2_BUCKET=sift-models
SIFT_MODEL_R2_PREFIX=models
# SIFT_WRANGLER_BIN=/absolute/path/to/wrangler
